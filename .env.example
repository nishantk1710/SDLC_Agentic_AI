# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Postgres + pgvector ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sdlc
POSTGRES_USER=sdlc
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://sdlc:change-me@localhost:5432/sdlc

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- API gateway ---
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=change-me
JWT_ALGORITHM=HS256

# --- Web ---
VITE_API_BASE_URL=http://localhost:8000

# --- LLM provider (Anthropic) ---
ANTHROPIC_API_KEY=change-me
DEFAULT_MODEL=claude-opus-4-8

# --- Orchestrator ---
IMPLEMENTATION_MAX_RETRIES=3


# --- testing-phase ---
# LLM for Stage A3 + Stage B (put the REAL key in .env, NOT here). Two verified
# Azure AI Foundry routings for Claude — use EITHER (model prefix must match host):
#   azure_ai/<name>  + base=https://<res>.openai.azure.com/            (Azure OpenAI host)
#   anthropic/<name> + base=https://<res>.services.ai.azure.com/anthropic/  (AI Foundry host)
TESTING_LLM_MODEL=azure_ai/claude-sonnet-4-6
TESTING_LLM_API_KEY=
TESTING_LLM_BASE_URL=https://<resource>.openai.azure.com/
TESTING_LLM_TEMPERATURE=0
TESTING_LLM_TIMEOUT=60

# Stage B — ZenseAI MCP test-case tool (optional, additive). Leave URL blank to
# use the direct-LLM fallback (the POC default). See ACCESS_NEEDED.md for what to
# request from the ZenseAI team.
TESTING_MCP_URL=
TESTING_MCP_API_KEY=          # sent to the tool as its `bearer_token` arg
TESTING_MCP_API_ID=           # sent to the tool as its `api_id` arg (aibuddy credential selector)
TESTING_MCP_TIMEOUT=20
# Tool function name to call (default matches the ZenseAI Python genie).
TESTING_MCP_TOOL_NAME=call_python_test_case_generation_genie
# Stage B derivation cache (1=on, 0=off).
TESTING_TCD_CACHE=1