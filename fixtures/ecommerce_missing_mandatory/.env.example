# ============================================================================
# .env.example — design-pack artifact E2 (owner: M4 — Standards & Assembly)
# Copy to `.env` and fill in real values. SAFE PLACEHOLDERS ONLY in this file —
# never commit real secrets. One variable per line, no quotes needed.
# ============================================================================

# ---- runtime -----------------------------------------------------------------
NODE_ENV=development

# ---- backend (NestJS, apps listen on PORT) -----------------------------------
PORT=3000
API_PREFIX=/api/v1

# PostgreSQL 16 connection string (docker compose default shown)
DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@localhost:5432/ecommerce

# JWT signing (NFR-001: tokens expire after 3600 seconds)
# Generate a real secret with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=3600

# Password hashing (NFR-002)
BCRYPT_COST=12

# Business config (BR-006 — flat shipping fee, USD)
SHIPPING_FLAT_FEE=5.00

# CORS: the Vite dev server origin
CORS_ORIGIN=http://localhost:5173

# ---- frontend (Vite — only VITE_* vars reach the browser) ---------------------
VITE_API_BASE_URL=http://localhost:3000/api/v1
