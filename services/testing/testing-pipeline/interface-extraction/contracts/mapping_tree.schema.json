{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mapping_tree",
  "description": "A2 output — symbol-keyed call/dependency graph (Module A).",
  "type": "object",
  "required": ["schema_version", "symbols", "edges", "stats"],
  "properties": {
    "schema_version": { "type": "string" },
    "symbols": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["symbol_id", "symbol_type", "calls", "called_by", "external_calls"],
        "properties": {
          "symbol_id": { "type": "string" },
          "filename": { "type": ["string", "null"] },
          "language": { "type": ["string", "null"] },
          "symbol_type": { "type": "string" },
          "signature": { "type": "string" },
          "start_line": { "type": ["integer", "null"] },
          "end_line": { "type": ["integer", "null"] },
          "is_test": { "type": "boolean" },
          "is_endpoint": { "type": "boolean", "description": "Symbol is exposed via an HTTP route decorator." },
          "http_method": { "type": ["string", "null"], "description": "e.g. POST (null if not an endpoint)." },
          "route": { "type": ["string", "null"], "description": "e.g. /api/checkout (null if not an endpoint)." },
          "raises": { "type": "array", "items": { "type": "string" }, "description": "Exception types raised by the symbol." },
          "fan_in": { "type": "integer", "description": "F3 — number of callers (blast radius)." },
          "fan_out": { "type": "integer", "description": "F3 — number of resolved internal callees." },
          "calls": { "type": "array", "items": { "type": "string" } },
          "called_by": { "type": "array", "items": { "type": "string" } },
          "external_calls": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" }
        }
      }
    },
    "stats": {
      "type": "object",
      "properties": {
        "symbol_count": { "type": "integer" },
        "edge_count": { "type": "integer" },
        "file_count": { "type": "integer" }
      }
    }
  }
}
