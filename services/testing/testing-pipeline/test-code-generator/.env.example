# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- LLM provider (Claude via Azure AI Foundry, OpenAI-compatible endpoint) ---
AZURE_OPENAI_API_KEY=YOUR_API_KEY_HERE
ENDPOINT_URL=YOUR_ENDPOINT
# Optional -- defaults to 2024-08-01-preview if unset. Change if your
# resource requires a different API version.

DEFAULT_MODEL=claude-sonnet-4-6
# Optional -- defaults to 8192 if unset.
LLM_MAX_TOKENS=8192
