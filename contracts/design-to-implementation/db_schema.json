        },
        {
          "name": "restaurantName",
          "type": "String",
          "required": true
        },
        {
          "name": "status",
          "type": "String",
          "required": true,
          "enum": [
            "pendingRestaurantAcceptance",
            "accepted",
            "preparing",
            "ready",
            "outForDelivery",
            "delivered",
            "cancelledByCustomer",
            "cancelledByRestaurant",
            "cancelledByAdmin"
          ],
          "default": "pendingRestaurantAcceptance"
        },
        {
          "name": "fulfillmentType",
          "type": "String",
          "required": true,
          "enum": [
            "delivery",
            "pickup"
          ]
