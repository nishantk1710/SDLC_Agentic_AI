        {
          "name": "deliveryAddressId",
          "type": "ObjectId"
        }
      ],
      "indexes": [
        {
          "fields": [
            "customerId",
            "restaurantId"
          ],
          "unique": true
        },
        {
          "fields": [
            "customerId"
          ]
        }
      ]
    },
    {
      "name": "orders",
      "model": "Order",
      "comment": "Placed-order aggregate root; snapshots item names and prices for financial integrity; references Restaurant, Customer, and Agent",
      "fields": [
        {
          "name": "customerId",
          "type": "ObjectId",
          "ref": "Customer",
          "required": true
        },
        {
          "name": "restaurantId",
          "type": "ObjectId",
