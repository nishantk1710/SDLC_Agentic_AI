{
  "datastore": "document",
  "odm": "mongoose",
  "collections": [
    {
      "name": "users",
      "model": "User",
      "comment": "Single unified auth identity for all roles; role-specific profile data lives in its own collection referencing this document",
      "fields": [
        {
          "name": "email",
          "type": "String",
          "required": false,
          "unique": true,
          "sparse": true
        },
        {
          "name": "phone",
          "type": "String",
          "required": false,
          "unique": true,
          "sparse": true
        },
        {
          "name": "passwordHash",
          "type": "String",
          "required": true
        },
        {
          "name": "role",
          "type": "String",
          "required": true,
          "enum": [
            "customer",
            "restaurantManager",
            "deliveryAgent",
            "admin"
          ]
        },
        {
          "name": "isVerified",
          "type": "Boolean",
          "required": true,
          "default": false
        },
        {
          "name": "verificationToken",
          "type": "String"
        },
        {
          "name": "verificationTokenExpiry",
          "type": "Date"
        },
        {
          "name": "passwordResetToken",
          "type": "String"
        },
        {
          "name": "passwordResetExpiry",
          "type": "Date"
        },
        {
          "name": "failedLoginAttempts",
          "type": "Number",
          "required": true,
          "default": 0
        },
        {
          "name": "lockedUntil",
          "type": "Date"
        },
        {
          "name": "isActive",
          "type": "Boolean",
          "required": true,
          "default": true
        },
        {
          "name": "fullName",
          "type": "String",
          "required": true
        },
        {
          "name": "avatarUrl",
          "type": "String"
        }
      ],
      "indexes": [
        {
          "fields": [
            "email"
          ],
          "unique": true,
          "sparse": true
        },
        {
          "fields": [
            "phone"
          ],
          "unique": true,
          "sparse": true
        },
        {
          "fields": [
            "role"
          ]
        },
        {
          "fields": [
            "passwordResetToken"
          ],
          "sparse": true
        }
      ]
    },
    {
      "name": "customers",
      "model": "Customer",
      "comment": "Customer-specific profile extending User; holds saved delivery addresses",
      "fields": [
        {
          "name": "userId",
          "type": "ObjectId",
          "ref": "User",
          "required": true,
          "unique": true
        },
        {
          "name": "savedAddresses",
          "type": "[Object]",
          "fields": [
            {
              "name": "_id",
              "type": "ObjectId"
            },
            {
              "name": "label",
              "type": "String"
            },
            {
              "name": "line1",
              "type": "String",
              "required": true
            },
            {
              "name": "line2",
              "type": "String"
            },
            {
              "name": "city",
              "type": "String",
              "required": true
            },
            {
              "name": "postcode",
              "type": "String",
              "required": true
            },
            {
              "name": "coordinates",
              "type": "Object",
              "fields": [
                {
                  "name": "lat",
                  "type": "Number",
                  "required": true
                },
                {
                  "name": "lng",
                  "type": "Number",
                  "required": true
                }
              ]
            },
            {
              "name": "isDefault",
              "type": "Boolean",
              "default": false
            }
          ]
        },
        {
          "name": "preferredPaymentMethod",
          "type": "String",
          "enum": [
            "card",
            "wallet",
            "cod"
          ]
        }
      ],
      "indexes": [
        {
          "fields": [
            "userId"
          ],
          "unique": true
        }
      ]
    },
    {
      "name": "restaurantManagers",
      "model": "RestaurantManager",
      "comment": "Restaurant-manager-specific profile; links a user to one restaurant",
      "fields": [
        {
          "name": "userId",
          "type": "ObjectId",
          "ref": "User",
          "required": true,
          "unique": true
        },
        {
          "name": "restaurantId",
          "type": "ObjectId",
          "ref": "Restaurant",
          "required": true
        }
      ],
      "indexes": [
        {
          "fields": [
            "userId"
          ],
          "unique": true
        },
        {
          "fields": [
            "restaurantId"
          ]
        }
      ]
    },
    {
      "name": "deliveryAgents",
      "model": "DeliveryAgent",
      "comment": "Delivery-agent-specific profile with live availability and location state",
      "fields": [
        {
          "name": "userId",
          "type": "ObjectId",
          "ref": "User",
          "required": true,
          "unique": true
        },
        {
          "name": "status",
          "type": "String",
          "required": true,
          "enum": [
            "offline",
            "available",
            "busy"
          ],
          "default": "offline"
        },
        {
          "name": "isApproved",
          "type": "Boolean",
          "required": true,
          "default": false
        },
        {
          "name": "isSuspended",
          "type": "Boolean",
          "required": true,
          "default": false
        },
        {
          "name": "currentLocation",
          "type": "Object",
          "fields": [
            {
              "name": "lat",
              "type": "Number"
            },
            {
              "name": "lng",
              "type": "Number"
            },
            {
              "name": "updatedAt",
              "type": "Date"
            }
          ]
        },
        {
          "name": "vehicleType",
          "type": "String",
          "enum": [
            "bicycle",
            "motorcycle",
            "car"
          ]
        },
        {
          "name": "activeDeliveryId",
          "type": "ObjectId",
          "ref": "Delivery"
        }
      ],
      "indexes": [
        {
          "fields": [
            "userId"
          ],
          "unique": true
        },
        {
          "fields": [
            "status"
          ]
        },
        {
          "fields": [
            "currentLocation.lat",
            "currentLocation.lng"
          ]
        }
      ]
    },
    {
