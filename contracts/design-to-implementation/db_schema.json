        {
          "name": "allowsCOD",
          "type": "Boolean",
          "required": true,
          "default": false
        },
        {
          "name": "avgRating",
          "type": "Number",
          "default": 0
        },
        {
          "name": "reviewCount",
          "type": "Number",
          "default": 0
        },
        {
          "name": "commissionRate",
          "type": "Number"
        },
        {
          "name": "menuCategories",
          "type": "[Object]",
          "fields": [
            {
              "name": "_id",
              "type": "ObjectId"
            },
            {
              "name": "name",
              "type": "String",
              "required": true
            },
            {
              "name": "description",
              "type": "String"
            },
            {
              "name": "sortOrder",
              "type": "Number",
              "default": 0
            },
            {
              "name": "isActive",
              "type": "Boolean",
              "default": true
            },
            {
              "name": "items",
              "type": "[Object]",
              "fields": [
                {
                  "name": "_id",
                  "type": "ObjectId"
                },
                {
                  "name": "name",
                  "type": "String",
                  "required": true
                },
                {
                  "name": "description",
                  "type": "String"
                },
                {
                  "name": "price",
                  "type": "Decimal128",
                  "required": true
                },
                {
                  "name": "imageUrl",
                  "type": "String"
                },
                {
                  "name": "isAvailable",
                  "type": "Boolean",
                  "required": true,
                  "default": true
                },
                {
                  "name": "sortOrder",
                  "type": "Number",
                  "default": 0
                },
                {
                  "name": "tags",
                  "type": "[String]"
                }
              ]
            }
