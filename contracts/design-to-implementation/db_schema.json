        {
          "name": "cancellationReason",
          "type": "String"
        },
        {
          "name": "deliveryAgentId",
          "type": "ObjectId",
          "ref": "DeliveryAgent"
        },
        {
          "name": "statusHistory",
          "type": "[Object]",
          "fields": [
            {
              "name": "status",
              "type": "String",
              "required": true
            },
            {
              "name": "changedAt",
              "type": "Date",
              "required": true
            },
            {
              "name": "changedBy",
              "type": "ObjectId",
              "ref": "User"
            }
          ]
        },
        {
          "name": "estimatedDeliveryMinutes",
          "type": "Number"
        },
        {
          "name": "placedAt",
          "type": "Date",
          "required": true
        },
        {
          "name": "acceptedAt",
          "type": "Date"
        },
        {
          "name": "deliveredAt",
          "type": "Date"
        }
      ],
      "indexes": [
        {
          "fields": [
            "customerId",
            "placedAt"
          ]
        },
        {
          "fields": [
            "restaurantId",
            "status"
          ]
        },
        {
          "fields": [
            "restaurantId",
            "placedAt"
          ]
        },
        {
          "fields": [
            "deliveryAgentId",
            "status"
          ]
        },
        {
          "fields": [
            "status"
          ]
        },
        {
          "fields": [
            "placedAt"
          ]
        }
      ]
    },
    {
      "name": "payments",
      "model": "Payment",
      "comment": "One payment record per order; stores gateway reference and tokenized method details only — no raw card data",
      "fields": [
        {
          "name": "orderId",
          "type": "ObjectId",
          "ref": "Order",
          "required": true,
          "unique": true
        },
        {
          "name": "customerId",
          "type": "ObjectId",
          "ref": "Customer",
          "required": true
        },
        {
          "name": "method",
          "type": "String",
          "required": true,
          "enum": [
            "card",
            "wallet",
            "cod"
          ]
        },
        {
          "name": "status",
          "type": "String",
          "required": true,
          "enum": [
            "pending",
            "authorized",
            "captured",
            "failed",
            "refunded",
            "partiallyRefunded",
            "voided"
          ],
          "default": "pending"
        },
        {
          "name": "amount",
          "type": "Decimal128",
          "required": true
        },
        {
          "name": "currency",
          "type": "String",
          "required": true,
          "default": "GBP"
        },
        {
          "name": "gatewayTransactionId",
          "type": "String"
        },
        {
          "name": "gatewayPaymentToken",
          "type": "String"
        },
        {
          "name": "gatewayResponse",
          "type": "Mixed"
        },
        {
          "name": "refunds",
          "type": "[Object]",
          "fields": [
            {
              "name": "amount",
              "type": "Decimal128",
              "required": true
            },
            {
              "name": "reason",
              "type": "String"
            },
            {
              "name": "gatewayRefundId",
              "type": "String"
            },
            {
              "name": "initiatedBy",
              "type": "ObjectId",
              "ref": "User"
            },
            {
              "name": "processedAt",
              "type": "Date"
            }
          ]
        },
        {
          "name": "paidAt",
          "type": "Date"
        }
      ],
      "indexes": [
        {
          "fields": [
            "orderId"
          ],
          "unique": true
        },
        {
          "fields": [
            "customerId"
          ]
        },
        {
          "fields": [
            "gatewayTransactionId"
          ],
          "sparse": true
        },
        {
          "fields": [
            "status"
          ]
        }
      ]
    },
