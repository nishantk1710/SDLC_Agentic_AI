            },
            {
              "name": "city",
              "type": "String",
              "required": true
            },
            {
              "name": "postcode",
              "type": "String",
              "required": true
            },
            {
              "name": "coordinates",
              "type": "Object",
              "fields": [
                {
                  "name": "lat",
                  "type": "Number",
                  "required": true
                },
                {
                  "name": "lng",
                  "type": "Number",
                  "required": true
                }
              ]
            }
          ]
        },
        {
          "name": "phone",
          "type": "String"
        },
        {
          "name": "isOpen",
          "type": "Boolean",
          "required": true,
          "default": false
        },
        {
          "name": "isApproved",
          "type": "Boolean",
          "required": true,
          "default": false
        },
        {
          "name": "isSuspended",
          "type": "Boolean",
          "required": true,
          "default": false
        },
        {
          "name": "operatingHours",
          "type": "[Object]",
          "fields": [
            {
              "name": "dayOfWeek",
