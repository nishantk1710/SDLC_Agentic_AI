    {
      "name": "carts",
      "model": "Cart",
      "comment": "One active cart per customer per restaurant; cleared on order placement or explicit abandon",
      "fields": [
        {
          "name": "customerId",
          "type": "ObjectId",
          "ref": "Customer",
          "required": true
        },
        {
          "name": "restaurantId",
          "type": "ObjectId",
          "ref": "Restaurant",
          "required": true
        },
        {
          "name": "items",
          "type": "[Object]",
          "fields": [
            {
              "name": "menuItemId",
              "type": "ObjectId",
              "required": true
            },
            {
              "name": "name",
              "type": "String",
              "required": true
            },
            {
              "name": "price",
              "type": "Decimal128",
              "required": true
            },
            {
              "name": "quantity",
              "type": "Number",
              "required": true
            },
            {
              "name": "imageUrl",
              "type": "String"
            }
          ]
        },
        {
          "name": "subtotal",
          "type": "Decimal128",
          "required": true
        },
        {
          "name": "deliveryFeeSnapshot",
          "type": "Decimal128"
        },
        {
          "name": "taxAmount",
          "type": "Decimal128"
        },
        {
          "name": "total",
          "type": "Decimal128"
        },
        {
          "name": "fulfillmentType",
          "type": "String",
          "enum": [
            "delivery",
            "pickup"
          ],
