            {
              "name": "line1",
              "type": "String",
              "required": true
            },
            {
              "name": "line2",
              "type": "String"
            },
            {
              "name": "city",
              "type": "String",
              "required": true
            },
            {
              "name": "postcode",
              "type": "String",
              "required": true
            },
            {
              "name": "coordinates",
              "type": "Object",
              "fields": [
                {
                  "name": "lat",
                  "type": "Number"
                },
                {
                  "name": "lng",
                  "type": "Number"
                }
              ]
            }
          ]
        },
        {
          "name": "items",
          "type": "[Object]",
          "fields": [
            {
              "name": "menuItemId",
              "type": "ObjectId",
              "required": true
            },
            {
              "name": "name",
              "type": "String",
              "required": true
            },
            {
              "name": "unitPrice",
              "type": "Decimal128",
              "required": true
            },
            {
              "name": "quantity",
              "type": "Number",
              "required": true
            },
            {
              "name": "lineTotal",
              "type": "Decimal128",
              "required": true
            }
          ]
        },
        {
          "name": "subtotal",
          "type": "Decimal128",
          "required": true
        },
        {
          "name": "deliveryFee",
          "type": "Decimal128",
          "required": true
        },
        {
          "name": "taxAmount",
          "type": "Decimal128",
          "required": true
        },
        {
          "name": "total",
          "type": "Decimal128",
          "required": true
        },
        {
          "name": "commissionAmount",
          "type": "Decimal128"
        },
        {
          "name": "rejectionReason",
          "type": "String"
